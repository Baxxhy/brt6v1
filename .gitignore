# 只保留 code 和 test 两个目录
# =========================
retrieval_results/*
!retrieval_results/code/
!retrieval_results/code/**
!retrieval_results/test/
!retrieval_results/test/**

# 明确不要这些大文件/中间文件
retrieval_results/graphs/
retrieval_results/swe_test_cgs/
*.db
*.sqlite
*.sqlite3
*.pkl
*.pickle
