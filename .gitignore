# =========================
# Python cache / build
# =========================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# =========================
# OS / editor
# =========================
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example
*.env
.secrets/
.cache/
.bootstrap/
secrets/
secret/
*.pem
*.key
*.token
*token*
*secret*
*apikey*
*api_key*
openai*.json
deepseek*.json

# These tracked utilities contain no credentials; their names match the broad
# secret-file guards above, so explicitly keep them in reproducible clones.
!scripts/configure_api_keys.py
!scripts/check_repository_secrets.py

# API configuration belongs in the ignored files above or a secret manager.

# API pools are machine-local.  Reproduction servers create them with
# scripts/configure_api_keys.py; only config/api_pool.example.json is tracked.

# =========================
# Logs
# =========================
logs/
*.log
*.pid

