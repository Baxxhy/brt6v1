# Copy this file to .env. Never commit .env or real keys.
DEEPSEEK_API_KEY=REPLACE_WITH_ONE_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v3

# For multiple keys sharing one endpoint, use a comma-separated list instead:
# DEEPSEEK_API_KEYS=key_1,key_2,key_3
# DEEPSEEK_BASE_URLS=https://api.deepseek.com
# DEEPSEEK_MODELS=deepseek-v3

# Recommended for multiple endpoints or per-key models:
# BRT_API_POOL_FILE=/absolute/path/to/api_pool.json

# GPT-compatible endpoint used by `--model gpt`:
# GPT_API_KEY=REPLACE_WITH_ONE_GPT_KEY
# GPT_API_KEYS=key_1,key_2
# GPT_BASE_URL=https://aigc.x-see.cn/v1
# GPT_MODEL=gpt-5.4-mini
